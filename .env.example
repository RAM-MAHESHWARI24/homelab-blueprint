# ==============================================================================
# Master Homelab Blueprint Unified Environment Configuration
# ==============================================================================
# This template documents all environment variables across the entire server:
# host configuration, media pipeline, dashboard, power management, and cloud backup.
#
# For component-specific deployments, see the respective '.env.example' files:
#   - apps/mediaserver/.env.example
#   - apps/control-hub/.env.example
#   - apps/immich-face-xmp-exporter/.env.example
#   - apps/tv-updater/config.example.json
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host System & User Permissions
# ------------------------------------------------------------------------------
# Non-root administrative user running Docker, cron jobs, and Python daemons
HOST_USER=homelab_user
PUID=1000
PGID=1000

# Server Local IP Address (LAN)
SERVER_IP=192.168.1.100

# Server Timezone
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Storage Partitioning Architecture
# ------------------------------------------------------------------------------
# SSD Root: Operating system, Docker overlays, PostgreSQL DB, application state
SSD_ROOT=/

# Mechanical HDD: Media library and torrent storage (Single mount for 0 I/O hardlinks)
HDD_DATA=/mnt/hdd/data

# Mechanical HDD: Family photos and video cloud (Immich / Memories)
HDD_MEMORIES=/mnt/hdd/Memories

# ------------------------------------------------------------------------------
# 3. Media Ingest Suite API Keys (Settings -> General -> Security)
# ------------------------------------------------------------------------------
RADARR_API_KEY=YOUR_RADARR_API_KEY
SONARR_API_KEY=YOUR_SONARR_API_KEY
PROWLARR_API_KEY=YOUR_PROWLARR_API_KEY

# ------------------------------------------------------------------------------
# 4. Control Hub Dashboard Settings
# ------------------------------------------------------------------------------
CONTROL_HUB_PORT=7575
ACTIVE_NIC=eth0
LINK_SPEED_MBPS=1000
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin

# ------------------------------------------------------------------------------
# 5. Cloud Backup & Remote Storage
# ------------------------------------------------------------------------------
# Rclone remote name configured via 'rclone config'
GDRIVE_REMOTE=gdrive:
