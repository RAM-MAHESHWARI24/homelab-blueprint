# ==============================================================================
# Homelab Blueprint - blueprint-wide configuration template
# ==============================================================================
# The setup wizard renders this to /etc/homelab/homelab.env (0600) together
# with one env file per module:
#   /etc/homelab/mediaserver.env     <- apps/mediaserver/.env.example
#   /etc/homelab/noodle-gallery.env  <- apps/noodle-gallery/.env.example
#   /etc/homelab/control-hub.env     <- apps/control-hub/.env.example
#   /etc/homelab/tv-autoupdater.json <- apps/tv-autoupdater/config.example.json
# Secrets left empty here are generated at install time; none are shipped.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host user and permissions
# ------------------------------------------------------------------------------
# Your login user; containers run with this UID/GID so files stay editable by you.
# Find yours with:  id -u && id -g
HOST_USER=
PUID=1000
PGID=1000

# LAN IP of this server (auto-detected by the wizard)
SERVER_IP=

# IANA timezone, e.g. UTC, Europe/London, America/New_York, Asia/Kolkata.
# Auto-detected from the host when left empty.
TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 2. Storage layout
# ------------------------------------------------------------------------------
# Root filesystem (OS, Docker, databases): keep on the SSD.
SSD_ROOT=/

# ONE mount for downloads AND media so imports are instant hardlinks (0 copy, 0 extra space).
# Layout: $HDD_DATA/torrents/{movies,tv} and $HDD_DATA/media/{movies,tv}
HDD_DATA=/mnt/hdd/data

# Photo and video library for the photo cloud module.
HDD_MEMORIES=/mnt/hdd/Memories

# ------------------------------------------------------------------------------
# 3. Media pipeline API keys (generated at install; read back from each app's config.xml)
# ------------------------------------------------------------------------------
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# ------------------------------------------------------------------------------
# 4. Control Hub
# ------------------------------------------------------------------------------
CONTROL_HUB_PORT=7575
# Leave empty to auto-detect the default-route interface (enp3s0, eno1, ...).
ACTIVE_NIC=
LINK_SPEED_MBPS=1000
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

# ------------------------------------------------------------------------------
# 5. Optional cloud backup (noodle-gallery-tools): rclone remote name, e.g. "gdrive:"
# ------------------------------------------------------------------------------
GDRIVE_REMOTE=
