[Unit]
Description=Homelab Control Hub (dashboard and node management API)
Documentation=https://github.com/RAM-MAHESHWARI24/homelab-blueprint
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
# Unprivileged service account created by the installer. It is a member of the
# docker group, which is root-equivalent on the host; the bearer token in
# CONTROL_HUB_TOKEN is the security boundary.
User=homelab
Group=homelab
SupplementaryGroups=docker
WorkingDirectory={{INSTALL_DIR}}/apps/control-hub
EnvironmentFile=-{{ETC_DIR}}/control-hub.env
ExecStart={{PYTHON}} {{INSTALL_DIR}}/apps/control-hub/server.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Hardening
NoNewPrivileges=false
ProtectSystem=false
PrivateTmp=true

# Low-power resource bounds (prevents runaway processes)
CPUQuota=20%
MemoryMax=100M

[Install]
WantedBy=multi-user.target
