# ==============================================================================
# Noodle Gallery (Open-Noodle / Immich) - environment template
# Used by: docker-compose.yml (both as compose variables and inside the containers)
# ==============================================================================
# Standalone:  cp .env.example .env  and set at least DB_PASSWORD.
# Blueprint install: rendered to /etc/homelab/noodle-gallery.env by the installer.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage locations
# ------------------------------------------------------------------------------
# Uploaded photos, live photos and videos. Large, slow disk is fine.
UPLOAD_LOCATION=/mnt/hdd/Memories/uploads

# PostgreSQL data and vector embeddings. Put this on the SSD; network shares are not supported.
DB_DATA_LOCATION=/srv/homelab/appdata/noodle-gallery/postgres

# Thumbnail cache and transcoded video cache (SSD recommended).
THUMBS_LOCATION=/srv/homelab/appdata/noodle-gallery/thumbs
ENCODED_VIDEO_LOCATION=/srv/homelab/appdata/noodle-gallery/encoded-video

# Existing photo collection mounted as an external library (optional).
EXTERNAL_LIBRARY_LOCATION=/mnt/hdd/Memories
# Where the server sees it, and ro/rw. A library moved from another install must keep
# the path its database recorded (for example /mnt/hdd/Memories), or every asset goes offline.
# rw lets the server write XMP sidecars next to the originals. The ML container always mounts it ro.
EXTERNAL_LIBRARY_MOUNT_PATH=/mnt/media
EXTERNAL_LIBRARY_MOUNT_MODE=ro

# ------------------------------------------------------------------------------
# 2. Network and timezone
# ------------------------------------------------------------------------------
GALLERY_PORT=2283
# IANA timezone, e.g. UTC, Europe/London, Asia/Kolkata
TZ=UTC

# ------------------------------------------------------------------------------
# 3. Database credentials (REQUIRED)
# ------------------------------------------------------------------------------
# Alphanumeric only [A-Za-z0-9]. Generate one with:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))"
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_HOSTNAME=database
REDIS_HOSTNAME=redis

# ------------------------------------------------------------------------------
# 4. Machine learning container
# ------------------------------------------------------------------------------
# "no" (default): started/stopped on a schedule by the optional ML schedule module.
# "unless-stopped": always on (needs ~1-2 GB RAM while indexing).
ML_RESTART_POLICY=no
