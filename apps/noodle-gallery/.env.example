# ==============================================================================
# Noodle Gallery (Open-Noodle) - Environment Configuration Template
# Used by: apps/noodle-gallery/docker-compose.yml
# ==============================================================================
# Copy this file to '.env' before starting the stack:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Storage & Directory Locations
# ------------------------------------------------------------------------------
# UPLOAD_LOCATION: Directory where all uploaded photos, live photos, and videos are saved.
# For best longevity, place this on a large mechanical hard drive (HDD) or NAS share.
UPLOAD_LOCATION=/mnt/hdd/immich

# DB_DATA_LOCATION: Directory where PostgreSQL and vector embeddings are stored.
# IMPORTANT: Put this on a fast Solid State Drive (SSD) for snappy gallery browsing.
# Network shares (NFS/SMB) are NOT supported for the database!
DB_DATA_LOCATION=./data/postgres

# THUMBS_LOCATION: High-resolution & square thumbnail cache.
THUMBS_LOCATION=./data/thumbs

# ENCODED_VIDEO_LOCATION: Transcoded video stream cache for web and mobile playback.
ENCODED_VIDEO_LOCATION=./data/encoded-video

# EXTERNAL_LIBRARY_LOCATION: (Optional) Path to existing read-only photo collections.
EXTERNAL_LIBRARY_LOCATION=/mnt/hdd/Memories

# ------------------------------------------------------------------------------
# 2. Network & Listening Port
# ------------------------------------------------------------------------------
# HTTP port for the web dashboard and mobile app API (Default: 2283)
GALLERY_PORT=2283

# Server timezone for timestamping photos and cron execution.
# Examples: "Asia/Kolkata", "America/New_York", "Europe/London", "UTC"
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 3. Database Credentials (PostgreSQL with VectorChord / pgvector)
# ------------------------------------------------------------------------------
# Choose a strong password. Use only alphanumeric characters [A-Za-z0-9].
DB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ------------------------------------------------------------------------------
# 4. Image Tags & Release Channel
# ------------------------------------------------------------------------------
# Open-Noodle Gallery Release tag (Default: "release")
NOODLE_VERSION=release

# Upstream Immich Version (if using standard immich-app images):
IMMICH_VERSION=release
