# ==============================================================================
# Control Hub Dashboard & Management Daemon Configuration Template
# Used by: config.py, server.py, and widgets/*.py
# ==============================================================================
# Copy this file to '.env' in this directory before starting:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Daemon HTTP Server Binding
# ------------------------------------------------------------------------------
# HOST: IP address to bind the Flask web daemon ("0.0.0.0" listens on all interfaces)
CONTROL_HUB_HOST=0.0.0.0
# PORT: HTTP port for the web dashboard (Default: 7575)
CONTROL_HUB_PORT=7575

# ------------------------------------------------------------------------------
# 2. Real-Time Network Throughput Sampler
# ------------------------------------------------------------------------------
# ACTIVE_NIC: The network interface name used for measuring live Rx/Tx bandwidth.
# Run 'ip -br link' or 'ip route show default' to identify your active interface.
# Common examples: "eth0", "enp3s0", "wlan0", or USB dongles like "enx00e04c4b4518"
ACTIVE_NIC=eth0

# LINK_SPEED_MBPS: Maximum negotiated link speed in megabits per second.
# Used to calculate the percentage capacity gauge on the dashboard.
# Common values: 1000 (Gigabit Ethernet), 100 (Fast Ethernet), 2500 (2.5G)
LINK_SPEED_MBPS=1000

# ------------------------------------------------------------------------------
# 3. qBittorrent Ingest Integration
# ------------------------------------------------------------------------------
# Credentials to connect to the qBittorrent WebUI API for download telemetry
# and 1-click download queue toggling.
QBITTORRENT_URL=http://127.0.0.1:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASS=adminadmin

# ------------------------------------------------------------------------------
# 4. CleanYourTV (Android TV Updater) Integration
# ------------------------------------------------------------------------------
# Paths to the CleanYourTV engine and runtime state for the dashboard fleet card
TV_UPDATER_DIR=../tv-updater
TV_UPDATER_PY=../tv-updater/tv_updater.py
TV_UPDATER_STATE_FILE=../tv-updater/state.json
TV_UPDATER_INCOMING_DIR=../tv-updater/incoming_apks
TV_UPDATER_LOG_FILE=/var/log/tv-updater.log

# ------------------------------------------------------------------------------
# 5. System Power & Backup File Triggers
# ------------------------------------------------------------------------------
# Files managed by the Sleep Guard widget and Backup Sync card:
SUSPEND_SKIP_FILE=/run/server-suspend.skip
SUSPEND_OVERRIDE_FILE=/run/server-suspend.override
SUSPEND_CONFIG_FILE=/etc/server-suspend.conf
SUSPEND_CRON_FILE=/etc/cron.d/server-suspend
SERVER_SUSPEND_LOG_FILE=/var/log/server-suspend.log

# Backup & Sync Logs
BACKUP_LOG_FILE=/opt/immich/backups/backup.log
BACKUP_DIR=/opt/immich/backups
WATCHTOWER_LOG_DIR=/var/log/watchtower
RECYCLARR_LOG_FILE=/var/log/recyclarr.log
IMMICH_ML_LOG_FILE=/var/log/immich-ml.log

# ------------------------------------------------------------------------------
# 6. Ookla Speedtest Integration (Optional)
# ------------------------------------------------------------------------------
SPEEDTEST_BIN=/usr/local/bin/speedtest
SPEEDTEST_CACHE_FILE=./speedtest_cache.json
