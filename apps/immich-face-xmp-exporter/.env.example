# ==============================================================================
# Immich Face-to-XMP Exporter & Cloud Backup Toolkit Configuration Template
# Used by: export_faces_to_xmp.py, sync_space_faces.py, scripts/immich_backup_gdrive.sh.example
# ==============================================================================
# Copy this file to '.env' in this directory before running:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Immich REST API Credentials (sync_space_faces.py)
# ------------------------------------------------------------------------------
# URL to your Immich server instance (default internal: http://127.0.0.1:2283)
IMMICH_URL=http://127.0.0.1:2283

# Generate an API key in Immich:
# Open Immich Web -> User Settings (top right) -> API Keys -> Create New Key
IMMICH_API_KEY=YOUR_IMMICH_API_KEY

# ------------------------------------------------------------------------------
# 2. Immich PostgreSQL Database Direct Access (export_faces_to_xmp.py)
# ------------------------------------------------------------------------------
# Container name running Immich PostgreSQL (defined in your immich docker compose)
IMMICH_POSTGRES_CONTAINER=immich_postgres
DB_USER=postgres
DB_NAME=immich

# Cache file tracking already-exported photos to allow sub-5-second runs
FACES_CACHE_FILE=./.faces_export_cache.json

# ------------------------------------------------------------------------------
# 3. Cloud Mirror & Backup Pipeline (scripts/immich_backup_gdrive.sh.example)
# ------------------------------------------------------------------------------
# Local directory where database sql.gz snapshots are stored
BACKUP_LOCAL=/opt/immich/backups

# Local root directory containing your original photos
MEDIA_PATH=/mnt/hdd/Memories

# Rclone remote destination (e.g. Google Drive, Backblaze B2, AWS S3)
# Configure your remote first using 'rclone config'
GDRIVE_REMOTE=gdrive:
