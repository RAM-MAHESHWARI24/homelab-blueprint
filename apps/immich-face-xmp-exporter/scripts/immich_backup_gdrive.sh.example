#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# Immich Automated Backup & Cloud Mirror Script
# Dumps PostgreSQL database snapshot & mirrors media library to cloud with
# server-side move tracking and accidental deletion protection.
#
# 0. Pre-flight: the remote answers, its folders exist, there is room locally and
#    on the remote, and the photo folder is not empty (an unmounted disk would
#    otherwise sync an empty folder over the cloud copy). Any failure stops the run.
# 1. Face tags to XMP sidecars   2. PostgreSQL dump   3. Upload dump, mirror photos
# 4. Retention and verification. Every step updates status.json (0644, atomic),
#    which the Control Hub reads; it keeps the last 30 runs as history.
# ==============================================================================

# All settings come from the environment (the blueprint sets them in /etc/cron.d/immich-backup):
#   BACKUP_LOCAL        local directory for database dumps, logs and status.json
#   MEDIA_PATH          photo library to mirror
#   GDRIVE_REMOTE       rclone remote (and optional path), e.g. "gdrive:" or "gdrive:homelab/"
#   FACE_EXPORTER       path to export_faces_to_xmp.py (defaults to the copy next to this script)
#   DB_CONTAINER        postgres container name (default immich_postgres)
#   KEEP_LOCAL_DUMPS    nightly dumps kept on this server (default 3)
#   KEEP_DRIVE_DUMPS    newest nightly dumps kept on the remote (default 14)
#   KEEP_DRIVE_MONTHLY  months for which the remote also keeps the first dump (default 12; 0 = off)
#   BACKUP_HELPER       backup_status.py (defaults to scripts/ next to FACE_EXPORTER)
# A run started outside cron (the Control Hub's "Run backup now" goes through sudo,
# which clears the environment) reads any unset value from that cron file, so both
# runs use the same remote and paths. BACKUP_CRON_FILE overrides its location.
BACKUP_CRON_FILE="${BACKUP_CRON_FILE:-/etc/cron.d/immich-backup}"
if [ -r "$BACKUP_CRON_FILE" ]; then
    while IFS='=' read -r key value; do
        case "$key" in
            BACKUP_LOCAL|MEDIA_PATH|GDRIVE_REMOTE|FACE_EXPORTER|DB_CONTAINER|KEEP_LOCAL_DUMPS|KEEP_DRIVE_DUMPS|KEEP_DRIVE_MONTHLY|BACKUP_HELPER)
                if [ -z "${!key:-}" ]; then
                    printf -v "$key" '%s' "$value"
                    export "${key?}"
                fi
                ;;
        esac
    done < "$BACKUP_CRON_FILE"
fi
BACKUP_LOCAL="${BACKUP_LOCAL:-/var/lib/homelab/photo-backups}"
MEDIA_PATH="${MEDIA_PATH:-/mnt/hdd/Memories}"
GDRIVE_REMOTE="${GDRIVE_REMOTE:-gdrive:}"
case "$GDRIVE_REMOTE" in *:|*/) ;; *) GDRIVE_REMOTE="${GDRIVE_REMOTE}/" ;; esac
FACE_EXPORTER="${FACE_EXPORTER:-$(dirname "$0")/../export_faces_to_xmp.py}"
DB_CONTAINER="${DB_CONTAINER:-immich_postgres}"
KEEP_LOCAL_DUMPS="${KEEP_LOCAL_DUMPS:-3}"
KEEP_DRIVE_DUMPS="${KEEP_DRIVE_DUMPS:-14}"
KEEP_DRIVE_MONTHLY="${KEEP_DRIVE_MONTHLY:-12}"
BACKUP_HELPER="${BACKUP_HELPER:-$(dirname "$FACE_EXPORTER")/scripts/backup_status.py}"
GDRIVE_MEMORIES="${GDRIVE_REMOTE}Memories"
GDRIVE_DB_BACKUP="${GDRIVE_REMOTE}Immich_Backup/database"
DATE=$(date +%Y%m%d_%H%M%S)
LOG_FILE="${BACKUP_LOCAL}/backup.log"
STATUS_FILE="${BACKUP_LOCAL}/status.json"

mkdir -p "$BACKUP_LOCAL"

# One run at a time (the nightly cron job and "Run backup now" can overlap).
exec 9>"$BACKUP_LOCAL/.backup.lock"
if ! flock -n 9; then
    echo "Another backup run is in progress; not starting a second one." >&2
    exit 0
fi

exec > >(tee -a "$LOG_FILE") 2>&1

WORK="$(mktemp -d)"
STARTED_AT="$(date -Is)"
CURRENT_STAGE=0
STAGE_LABEL="0. Pre-flight"
CURRENT_MSG="Checking the remote, its folders and free space..."
FAIL_MSG=""
DUMP_BASENAME=""
DUMP_BYTES=""
BACKUP_DONE=0
PREFLIGHT_FILE="$WORK/preflight.tsv"
ABOUT_FILE="$WORK/about.json"
TRANSFER_FILE="$WORK/transfer.json"
RETENTION_FILE="$WORK/retention.json"
: > "$PREFLIGHT_FILE"

if [ ! -f "$BACKUP_HELPER" ]; then
    echo "Warning: $BACKUP_HELPER not found; status.json will not be updated."
fi

write_status() {
    # write_status <status> <completed_at>; the other values come from the globals above.
    [ -f "$BACKUP_HELPER" ] || return 0
    local args=(status --file "$STATUS_FILE" --status "$1" --stage "$CURRENT_STAGE"
        --label "$STAGE_LABEL" --message "$CURRENT_MSG" --started-at "$STARTED_AT"
        --completed-at "${2:-}" --remote "$GDRIVE_REMOTE" --dump-file "$DUMP_BASENAME"
        --dump-bytes "$DUMP_BYTES" --preflight-file "$PREFLIGHT_FILE")
    [ -s "$ABOUT_FILE" ] && args+=(--gdrive-json "$ABOUT_FILE")
    [ -s "$TRANSFER_FILE" ] && args+=(--transfer-json "$TRANSFER_FILE")
    [ -s "$RETENTION_FILE" ] && args+=(--retention-json "$RETENTION_FILE")
    python3 "$BACKUP_HELPER" "${args[@]}" || echo "Warning: could not write $STATUS_FILE"
}

stage() {
    CURRENT_STAGE="$1"; STAGE_LABEL="$2"; CURRENT_MSG="$3"
    write_status syncing
}

check() {
    # check <name> <ok|fail> <detail>: record a pre-flight result.
    printf '%s\t%s\t%s\n' "$1" "$2" "$3" >> "$PREFLIGHT_FILE"
    echo "  [$2] $1: $3"
}

fail() {
    FAIL_MSG="$1"
    echo "ERROR: $1"
    exit 1
}

on_exit() {
    local rc=$?
    if [ "$BACKUP_DONE" -eq 0 ] || [ "$rc" -ne 0 ]; then
        CURRENT_MSG="${FAIL_MSG:-Backup failed during step ${CURRENT_STAGE} (${STAGE_LABEL}, exit ${rc})}"
        write_status error "$(date -Is)"
    fi
    rm -rf "$WORK"
}
trap on_exit EXIT

human() { numfmt --to=iec-i --suffix=B "$1" 2>/dev/null || echo "$1 B"; }

echo "=================================================="
echo "Starting Immich Backup: $(date)"
echo "=================================================="
write_status syncing

# 0. Pre-flight ----------------------------------------------------------------
echo "[0/4] Pre-flight checks..."
command -v rclone >/dev/null 2>&1 || { check "rclone" fail "rclone is not installed"; fail "rclone is not installed"; }

if lsd_out="$(timeout 120 rclone lsd "$GDRIVE_REMOTE" 2>&1)"; then
    check "remote" ok "$GDRIVE_REMOTE answers"
else
    detail="$(printf '%s' "$lsd_out" | tail -n 1)"
    check "remote" fail "$GDRIVE_REMOTE did not answer: $detail"
    fail "Pre-flight: the remote $GDRIVE_REMOTE did not answer ($detail). Check the rclone login with: sudo rclone config reconnect ${GDRIVE_REMOTE%%:*}:"
fi

# A previous good run means the folders must already be there. If one is missing it
# was moved or renamed, and syncing into a new empty folder would upload everything again.
had_good_run=0
if [ -f "$STATUS_FILE" ] && grep -q '"last_good_at": "' "$STATUS_FILE"; then had_good_run=1; fi
top_dirs="$(timeout 120 rclone lsf --dirs-only "$GDRIVE_REMOTE" 2>/dev/null || true)"
backup_dirs="$(timeout 120 rclone lsf --dirs-only "${GDRIVE_REMOTE}Immich_Backup" 2>/dev/null || true)"
for folder in "Memories" "Immich_Backup/database"; do
    case "$folder" in
        Memories) present="$(printf '%s\n' "$top_dirs" | grep -qx 'Memories/' && echo yes || true)" ;;
        *) present="$(printf '%s\n' "$backup_dirs" | grep -qx 'database/' && echo yes || true)" ;;
    esac
    if [ -n "$present" ]; then
        check "folder $folder" ok "present"
    elif [ "$had_good_run" -eq 1 ]; then
        check "folder $folder" fail "missing on $GDRIVE_REMOTE"
        fail "Pre-flight: ${GDRIVE_REMOTE}${folder} is missing although earlier runs wrote to it. Was it moved or renamed?"
    else
        check "folder $folder" ok "not there yet; the first run creates it"
    fi
done

if [ ! -d "$MEDIA_PATH" ] || [ -z "$(ls -A "$MEDIA_PATH" 2>/dev/null | head -n 1)" ]; then
    check "photo folder" fail "$MEDIA_PATH is missing or empty"
    fail "Pre-flight: $MEDIA_PATH is missing or empty (is the disk mounted?). Not mirroring an empty folder over the cloud copy."
fi
check "photo folder" ok "$MEDIA_PATH has files"

last_dump_bytes="$(ls -1 "$BACKUP_LOCAL"/immich_db_*.sql.gz 2>/dev/null | sort | tail -n 1 | xargs -r stat -c %s 2>/dev/null || true)"
last_dump_bytes="${last_dump_bytes:-0}"
need_bytes=$(( last_dump_bytes * 2 > 1073741824 ? last_dump_bytes * 2 : 1073741824 ))
local_free="$(df -B1 --output=avail "$BACKUP_LOCAL" | tail -n 1 | tr -d ' ')"
if [ "$local_free" -lt "$need_bytes" ]; then
    check "local space" fail "$(human "$local_free") free in $BACKUP_LOCAL, need $(human "$need_bytes")"
    fail "Pre-flight: only $(human "$local_free") free in $BACKUP_LOCAL; the dump needs about $(human "$need_bytes")."
fi
check "local space" ok "$(human "$local_free") free"

if timeout 120 rclone about "$GDRIVE_REMOTE" --json > "$ABOUT_FILE" 2>/dev/null; then
    remote_free="$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1])).get("free") or -1))' "$ABOUT_FILE" 2>/dev/null || echo -1)"
    if [ "$remote_free" -ge 0 ] && [ "$remote_free" -lt "$need_bytes" ]; then
        check "remote space" fail "$(human "$remote_free") free on $GDRIVE_REMOTE"
        fail "Pre-flight: only $(human "$remote_free") free on $GDRIVE_REMOTE."
    fi
    check "remote space" ok "$( [ "$remote_free" -ge 0 ] && echo "$(human "$remote_free") free" || echo "not reported by this remote")"
else
    : > "$ABOUT_FILE"
    check "remote space" ok "not reported by this remote"
fi

# 1. Export named faces to XMP sidecars -----------------------------------------
stage 1 "1. Face XMP Export" "Exporting named faces to XMP sidecars..."
echo "[1/4] Running Face-to-XMP Exporter..."
if [ -f "$FACE_EXPORTER" ]; then
    python3 "$FACE_EXPORTER" || echo "Warning: Face export had warnings, continuing backup."
else
    echo "Warning: face exporter not found at $FACE_EXPORTER; skipping XMP export."
fi

# 2. Dump PostgreSQL database (consistent snapshot) -----------------------------
stage 2 "2. Postgres Dump" "Creating PostgreSQL database dump (pg_dumpall)..."
echo "[2/4] Creating PostgreSQL database dump..."
DB_DUMP="$BACKUP_LOCAL/immich_db_${DATE}.sql.gz"
COMPRESS_CMD=$(command -v pigz >/dev/null 2>&1 && echo "pigz -p 4 -1" || echo "gzip")
docker exec "$DB_CONTAINER" pg_dumpall -U postgres | $COMPRESS_CMD > "$DB_DUMP"
DUMP_BASENAME="$(basename "$DB_DUMP")"
DUMP_BYTES="$(wc -c < "$DB_DUMP" | tr -d '[:space:]')"
echo "Database dumped successfully: $DB_DUMP ($(du -h "$DB_DUMP" | cut -f1))"

# 3. Upload the dump, then mirror the photo library -----------------------------
stage 3 "3. Rclone Mirror" "Mirroring database dump & photo library to ${GDRIVE_REMOTE}..."
echo "[3/4] Uploading database dump to Cloud..."
rclone copy "$DB_DUMP" "$GDRIVE_DB_BACKUP/" --stats 30s --stats-log-level NOTICE 2>&1 | tee "$WORK/copy.log"

# Server-side move/rename tracking, and a trash folder instead of deleting anything.
echo "[3/4] Syncing Media library to Cloud ($GDRIVE_MEMORIES)..."
rclone sync "$MEDIA_PATH" "$GDRIVE_MEMORIES/" \
    --track-renames \
    --backup-dir "${GDRIVE_REMOTE}Immich_Trash/${DATE}" \
    --transfers 4 \
    --checkers 8 \
    --fast-list \
    --stats 60s \
    --stats-log-level NOTICE \
    --exclude ".dtrash/**" 2>&1 | tee "$WORK/sync.log"
if [ -f "$BACKUP_HELPER" ]; then
    python3 "$BACKUP_HELPER" stats "$WORK/copy.log" "$WORK/sync.log" > "$TRANSFER_FILE" || : > "$TRANSFER_FILE"
fi

# 4. Retention, then verify the dump is on the remote ----------------------------
stage 4 "4. GDrive Verified" "Applying retention and verifying the upload..."
echo "[4/4] Retention and verification..."
if [ -f "$BACKUP_HELPER" ]; then
    ls -1 "$BACKUP_LOCAL" > "$WORK/local.txt"
    python3 "$BACKUP_HELPER" retention --names-file "$WORK/local.txt" --keep "$KEEP_LOCAL_DUMPS" \
        --protect "$DUMP_BASENAME" | while read -r old; do
        echo "  local: deleting $old (keeping the newest $KEEP_LOCAL_DUMPS)"
        rm -f -- "$BACKUP_LOCAL/$old"
    done

    if rclone lsf --files-only "$GDRIVE_DB_BACKUP/" > "$WORK/remote.txt" 2>/dev/null; then
        python3 "$BACKUP_HELPER" retention --names-file "$WORK/remote.txt" --keep "$KEEP_DRIVE_DUMPS" \
            --monthly "$KEEP_DRIVE_MONTHLY" --protect "$DUMP_BASENAME" --json-out "$RETENTION_FILE" > "$WORK/remote-delete.txt"
        while read -r old; do
            [ -n "$old" ] || continue
            echo "  remote: deleting $old"
            rclone deletefile "$GDRIVE_DB_BACKUP/$old" || echo "  Warning: could not delete $old"
        done < "$WORK/remote-delete.txt"
        grep -qx "$DUMP_BASENAME" "$WORK/remote.txt" \
            || fail "The dump $DUMP_BASENAME is not on $GDRIVE_DB_BACKUP after the upload."
    else
        echo "  Warning: could not list $GDRIVE_DB_BACKUP; remote retention skipped this run."
    fi
fi

# Google Drive quota for the dashboard (best effort, never fails the backup)
timeout 120 rclone about "$GDRIVE_REMOTE" --json > "$ABOUT_FILE" 2>/dev/null || true

BACKUP_DONE=1
CURRENT_MSG="Cloud backup verified & protected on ${GDRIVE_REMOTE}"
write_status synced "$(date -Is)"

echo "=================================================="
echo "Immich Backup Completed Successfully: $(date)"
echo "=================================================="
