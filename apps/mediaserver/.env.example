# Mediaserver Environment Configuration
PUID=1000
PGID=1000
TZ=Asia/Kolkata

# Host Paths (Ensure DATA_DIR is a single mount for atomic hardlinks!)
CONFIG_DIR=./config
DATA_DIR=/mnt/hdd/data

# API Keys
RADARR_API_KEY=YOUR_RADARR_API_KEY
SONARR_API_KEY=YOUR_SONARR_API_KEY
PROWLARR_API_KEY=YOUR_PROWLARR_API_KEY
