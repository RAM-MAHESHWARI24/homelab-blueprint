# ==============================================================================
# Mediaserver Pipeline Environment Configuration Template
# Used by: docker-compose.yml
# ==============================================================================
# Copy this file to '.env' before starting the stack:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container User Permissions & Localization
# ------------------------------------------------------------------------------
# Set to the UID and GID of your host user to avoid file permission issues.
# On Linux, find your IDs by running: id -u && id -g
PUID=1000
PGID=1000

# Server timezone for scheduled tasks, logs, and cron jobs.
# Examples: "Asia/Kolkata", "America/New_York", "Europe/London", "UTC"
TZ=UTC

# ------------------------------------------------------------------------------
# 2. Host Storage & Single-Mount Atomic Hardlinks Architecture
# ------------------------------------------------------------------------------
# CONFIG_DIR: Directory where all persistent application databases, SQLite files,
# and configurations are stored.
# Default: "./config" (relative to docker-compose.yml) or "/opt/mediaserver/config"
CONFIG_DIR=./config

# DATA_DIR: THE CRITICAL ROOT MOUNT FOR ATOMIC HARDLINKS (0 Disk I/O).
# WARNING: All downloaders (qBittorrent) and media managers (Sonarr/Radarr) MUST
# share this exact same root host path mounted to '/data' inside containers.
# This allows instant hardlinks (0.001s) instead of copying gigabytes across mounts.
#
# Recommended structure inside DATA_DIR:
#   /data/
#   ├── torrents/
#   │   ├── movies/
#   │   └── tv/
#   └── media/
#       ├── movies/
#       └── tv/
DATA_DIR=/mnt/hdd/data

# ------------------------------------------------------------------------------
# 3. Default Exposed Ports Reference
# ------------------------------------------------------------------------------
# Jellyfin Media Streaming:        8096 (HTTP), 8920 (HTTPS)
# Seerr (Jellyseerr/Overseerr):    5055
# Sonarr (TV Series):              8989
# Radarr (Movies):                 7878
# Prowlarr (Indexer Proxy):        9696
# Bazarr (Subtitles):              6767
# qBittorrent WebUI:               8080
# qBittorrent BitTorrent Port:     6881 (TCP/UDP)
# Byparr (Cloudflare Solver):      8191

# ------------------------------------------------------------------------------
# 4. Ingest Application API Keys
# ------------------------------------------------------------------------------
# Retrieve these from each application's WebUI:
# Settings -> General -> Security -> API Key
# Used by scripts/webhook_listener.py
# Leave empty on a fresh install: the apps generate keys on first start and the
# blueprint's wiring script reads them back from each app's config.xml.
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# qBittorrent WebUI credentials (set by the wiring script on first start; no default shipped)
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

# ------------------------------------------------------------------------------
# 4b. Seerr DNS & optional TMDB DPI bypass (some ISPs reset api.themoviedb.org)
# ------------------------------------------------------------------------------
# Default forces IPv4 DNS order so containers on IPv4-only Docker bridges avoid
# ENETUNREACH. When ENABLE_TMDB_BYPASS=true, the installer adds:
# --require /app/config/tmdb-interceptor.js
SEERR_NODE_OPTIONS=--dns-result-order=ipv4first
ENABLE_TMDB_BYPASS=false

# Optional: force public DNS inside containers (comma separated). Empty = Docker default.
DNS_OVERRIDE=

# ------------------------------------------------------------------------------
# 4c. Release preferences (profile pack in profiles/, applied by
#     python3 scripts/wire_arr.py profiles apply --config-dir <appdata> --env-file .env)
# ------------------------------------------------------------------------------
# on = the pack owns the "1080p Compact" and "1080p Family" profiles and its own
# custom formats. off = leave profiles to another tool (for example Recyclarr).
MEDIA_PROFILES=on
# Second audio language for dual-audio releases, e.g. Hindi, Tamil, Spanish. Empty = none.
# Supported names: profiles/languages.json
MEDIA_SECOND_LANGUAGE=
# Default profile for new titles: compact (1080p Compact) or family (1080p Family, needs a language)
MEDIA_DEFAULT_PROFILE=compact
# What your TVs and players decode: comma list of hevc, av1, dv (Dolby Vision without HDR10)
MEDIA_CODECS=hevc
# while-it-helps (ratio 1.0, 24 h or 60 idle minutes, whichever first) or off
MEDIA_SEEDING=while-it-helps
# Stuck downloads: replace (automatic replacement, watch-only for the first 7 days) or off
MEDIA_STUCK_DOWNLOADS=replace
# Append the public tracker list (ngosang trackers_best) to new torrents. Set off as soon
# as you add a private tracker: private trackers forbid foreign trackers.
MEDIA_PUBLIC_TRACKERS=on

# ------------------------------------------------------------------------------
# 5. Webhook Listener Configuration (scripts/webhook_listener.py)
# ------------------------------------------------------------------------------
WEBHOOK_PORT=5050
RADARR_URL=http://localhost:7878
SONARR_URL=http://localhost:8989
LOGS_DIR=./scripts/logs
HISTORY_FILE=./scripts/download_history.json
