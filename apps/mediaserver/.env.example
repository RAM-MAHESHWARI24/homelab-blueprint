# ==============================================================================
# Mediaserver Pipeline Environment Configuration Template
# Used by: docker-compose.yml
# ==============================================================================
# Copy this file to '.env' before starting the stack:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container User Permissions & Localization
# ------------------------------------------------------------------------------
# Set to the UID and GID of your host user to avoid file permission issues.
# On Linux, find your IDs by running: id -u && id -g
PUID=1000
PGID=1000

# Server timezone for scheduled tasks, logs, and cron jobs.
# Examples: "Asia/Kolkata", "America/New_York", "Europe/London", "UTC"
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. Host Storage & Single-Mount Atomic Hardlinks Architecture
# ------------------------------------------------------------------------------
# CONFIG_DIR: Directory where all persistent application databases, SQLite files,
# and configurations are stored.
# Default: "./config" (relative to docker-compose.yml) or "/opt/mediaserver/config"
CONFIG_DIR=./config

# DATA_DIR: THE CRITICAL ROOT MOUNT FOR ATOMIC HARDLINKS (0 Disk I/O).
# WARNING: All downloaders (qBittorrent) and media managers (Sonarr/Radarr) MUST
# share this exact same root host path mounted to '/data' inside containers.
# This allows instant hardlinks (0.001s) instead of copying gigabytes across mounts.
#
# Recommended structure inside DATA_DIR:
#   /data/
#   ├── torrents/
#   │   ├── movies/
#   │   └── tv/
#   └── media/
#       ├── movies/
#       └── tv/
DATA_DIR=/mnt/hdd/data

# ------------------------------------------------------------------------------
# 3. Default Exposed Ports Reference
# ------------------------------------------------------------------------------
# Jellyfin Media Streaming:        8096 (HTTP), 8920 (HTTPS)
# Seerr (Jellyseerr/Overseerr):    5055
# Sonarr (TV Series):              8989
# Radarr (Movies):                 7878
# Prowlarr (Indexer Proxy):        9696
# Bazarr (Subtitles):              6767
# qBittorrent WebUI:               8080
# qBittorrent BitTorrent Port:     6881 (TCP/UDP)
# Byparr (Cloudflare Solver):      8191

# ------------------------------------------------------------------------------
# 4. Ingest Application API Keys
# ------------------------------------------------------------------------------
# Retrieve these from each application's WebUI:
# Settings -> General -> Security -> API Key
# Required for Recyclarr sync and scripts/webhook_listener.py
RADARR_API_KEY=YOUR_RADARR_API_KEY
SONARR_API_KEY=YOUR_SONARR_API_KEY
PROWLARR_API_KEY=YOUR_PROWLARR_API_KEY

# ------------------------------------------------------------------------------
# 5. Webhook Listener Configuration (scripts/webhook_listener.py)
# ------------------------------------------------------------------------------
WEBHOOK_PORT=5050
RADARR_URL=http://localhost:7878
SONARR_URL=http://localhost:8989
LOGS_DIR=./scripts/logs
HISTORY_FILE=./scripts/download_history.json
