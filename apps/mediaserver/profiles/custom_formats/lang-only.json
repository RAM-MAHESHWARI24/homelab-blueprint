{
  "name": "Lang · {LANG} only (original missing)",
  "comment": "A {LANG} dub without the original track: an acceptable last resort.",
  "apps": [
    "radarr",
    "sonarr"
  ],
  "when": "language",
  "includeCustomFormatWhenRenaming": false,
  "specifications": [
    {
      "name": "{LANG} token",
      "implementation": "ReleaseTitleSpecification",
      "negate": false,
      "required": true,
      "fields": {
        "value": "{LANG_RX}"
      }
    },
    {
      "name": "No dual or multi tag",
      "implementation": "ReleaseTitleSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "\\b(?:dual[ ._-]?audio|multi[ ._-]?audio|dual|multi)\\b"
      }
    },
    {
      "name": "Original not parsed",
      "implementation": "LanguageSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "Original"
      }
    }
  ]
}
