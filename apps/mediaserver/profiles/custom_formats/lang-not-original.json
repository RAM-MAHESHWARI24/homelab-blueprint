{
  "name": "Lang · Not Original or {LANG}",
  "name_without_language": "Lang · Not Original",
  "comment": "Third-language-only releases (German-only, Italian-only). Without a second language: anything without the original language.",
  "apps": [
    "radarr",
    "sonarr"
  ],
  "when": "always",
  "includeCustomFormatWhenRenaming": false,
  "specifications": [
    {
      "name": "Original not parsed",
      "implementation": "LanguageSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "Original"
      }
    },
    {
      "name": "{LANG} not parsed",
      "implementation": "LanguageSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "{LANG}"
      },
      "language_only": true
    },
    {
      "name": "No {LANG} token",
      "implementation": "ReleaseTitleSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "{LANG_RX}"
      },
      "language_only": true
    },
    {
      "name": "No dual or multi tag",
      "implementation": "ReleaseTitleSpecification",
      "negate": true,
      "required": true,
      "fields": {
        "value": "\\b(?:dual[ ._-]?audio|multi[ ._-]?audio|dual|multi)\\b"
      }
    }
  ]
}
